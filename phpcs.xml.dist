<?xml version="1.0"?>
<ruleset name="TAAS Loan Program">
	<description>Checks for PHP version compatibility, security and translation mistakes.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="colors"/>

	<!-- Code must run on PHP 7.4 and newer. -->
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Security: escaping output, checking nonces, cleaning input, safe SQL. -->
	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders"/>

	<!-- Translations must use the right text domain. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="sharing-club"/>
			</property>
		</properties>
	</rule>
</ruleset>
